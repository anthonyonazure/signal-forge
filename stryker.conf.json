{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test"
  },
  "mutate": [
    "src/chunk.ts",
    "src/dedupe.ts",
    "src/extract.ts",
    "src/ingest.ts",
    "src/link.ts",
    "src/sanitize.ts",
    "src/types.ts"
  ],
  "reporters": [
    "progress",
    "clear-text"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  }
}
