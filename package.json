{
  "name": "signal-forge",
  "version": "0.1.0",
  "description": "Robust extraction of structured signals from messy unstructured text",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "mutation": "stryker run",
    "check": "bun run typecheck && bun run lint",
    "build": "tsc",
    "extract": "tsx src/cli.ts",
    "eval": "tsx evals/run.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "dotenv": "^16.4.5",
    "mailparser": "^3.7.1",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "eslint": "^10.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
