{
  // The browser bundle is plain JavaScript targeting the DOM, so it cannot live
  // in the root tsconfig (Node lib, declaration emit, TypeScript sources only).
  // Giving it its own project is what lets typescript-eslint resolve `document`
  // and friends instead of reporting every DOM call as an unresolvable type.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["*.js"]
}
